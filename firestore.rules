rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any logged-in user can read the shared song library and their own
    // profile. This is a personal/single-owner app, so all authenticated
    // requests are trusted for reads; writes to songs still require auth.
    match /songs/{songId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
